CREATE CONSTRAINT BuildId_Unique
IF NOT EXISTS
FOR (b:Build)
REQUIRE b.BuildId IS UNIQUE;

CREATE CONSTRAINT MaterialId_Unique
IF NOT EXISTS
FOR (m:Material)
REQUIRE m.MaterialId IS UNIQUE;

CREATE CONSTRAINT SystemId_Unique
IF NOT EXISTS
FOR (s:AMSystem)
REQUIRE s.AmSystemId IS UNIQUE;

CREATE CONSTRAINT BuiltPartId_Unique
IF NOT EXISTS
FOR (p:BuiltPart)
REQUIRE p.BuiltPartId IS UNIQUE;