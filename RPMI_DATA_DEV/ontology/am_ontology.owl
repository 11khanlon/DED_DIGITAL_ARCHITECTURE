<?xml version="1.0"?>
<rdf:RDF xmlns="http://am-cdm.org/ontology#"
     xml:base="http://am-cdm.org/ontology"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#">

    <!-- ========================================= -->
    <!-- ONTOLOGY HEADER -->
    <!-- ========================================= -->

    <owl:Ontology rdf:about="http://am-cdm.org/ontology"/>

    <!-- ========================================= -->
    <!-- CLASSES -->
    <!-- ========================================= -->

    <owl:Class rdf:about="#Project"/>
    <owl:Class rdf:about="#AMMachine"/>
    <owl:Class rdf:about="#System"/>
    <owl:Class rdf:about="#ProcessPlan"/>

    <owl:Class rdf:about="#Material"/>
    <owl:Class rdf:about="#MaterialForm"/>
    <owl:Class rdf:about="#MaterialCertification"/>
    <owl:Class rdf:about="#MaterialProperty"/>
    <owl:Class rdf:about="#MaterialParameter"/>

    <owl:Class rdf:about="#Organization"/>
    <owl:Class rdf:about="#Person"/>
    <owl:Class rdf:about="#Qualification"/>

    <owl:Class rdf:about="#Build"/>
    <owl:Class rdf:about="#BuildGeometry"/>
    <owl:Class rdf:about="#GeometryRegion"/>

    <owl:Class rdf:about="#Parameter"/>
    <owl:Class rdf:about="#TICEvent"/>
    <owl:Class rdf:about="#Part"/>
    <owl:Class rdf:about="#TICInspection"/>
    <owl:Class rdf:about="#TestResult"/>

    <!-- ========================================= -->
    <!-- REASONING / ANALYTICS CLASSES -->
    <!-- ========================================= -->

    <owl:Class rdf:about="#HighPowerEvent">
        <rdfs:subClassOf rdf:resource="#TICEvent"/>
    </owl:Class>

    <owl:Class rdf:about="#CriticalRegion">
        <rdfs:subClassOf rdf:resource="#GeometryRegion"/>
    </owl:Class>

    <owl:Class rdf:about="#DefectRisk"/>
    <owl:Class rdf:about="#ThermalAnomaly">
        <rdfs:subClassOf rdf:resource="#TICEvent"/>
    </owl:Class>

    <!-- ========================================= -->
    <!-- OBJECT PROPERTIES -->
    <!-- ========================================= -->

    <!-- Project / Build -->

    <owl:ObjectProperty rdf:about="#hasBuild">
        <rdfs:domain rdf:resource="#Project"/>
        <rdfs:range rdf:resource="#Build"/>
    </owl:ObjectProperty>

    <!-- Build relationships -->

    <owl:ObjectProperty rdf:about="#usesMachine">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#AMMachine"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasProcessPlan">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#ProcessPlan"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasGeometry">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#BuildGeometry"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usesFeedstockMaterial">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#Material"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#usesSubstrateMaterial">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#Material"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#operatedBy">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#Person"/>
    </owl:ObjectProperty>

    <!-- Inverse relationships -->

    <owl:ObjectProperty rdf:about="#partOfProject">
        <owl:inverseOf rdf:resource="#hasBuild"/>
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#Project"/>
    </owl:ObjectProperty>

    <!-- Machine system hierarchy -->

    <owl:ObjectProperty rdf:about="#hasSystem">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="#System"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasParentSystem">
        <rdfs:domain rdf:resource="#System"/>
        <rdfs:range rdf:resource="#System"/>
    </owl:ObjectProperty>

    <!-- Material relationships -->

    <owl:ObjectProperty rdf:about="#hasMaterialForm">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="#MaterialForm"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasCertification">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="#MaterialCertification"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasMaterialProperty">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="#MaterialProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#definedByParameter">
        <rdfs:domain rdf:resource="#MaterialProperty"/>
        <rdfs:range rdf:resource="#MaterialParameter"/>
    </owl:ObjectProperty>

    <!-- Organization / Person -->

    <owl:ObjectProperty rdf:about="#belongsToOrganization">
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Organization"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasQualification">
        <rdfs:domain rdf:resource="#Person"/>
        <rdfs:range rdf:resource="#Qualification"/>
    </owl:ObjectProperty>

    <!-- Geometry -->

    <owl:ObjectProperty rdf:about="#hasRegion">
        <rdfs:domain rdf:resource="#BuildGeometry"/>
        <rdfs:range rdf:resource="#GeometryRegion"/>
    </owl:ObjectProperty>

    <!-- Event-region relationship -->

    <owl:ObjectProperty rdf:about="#occursInRegion">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="#GeometryRegion"/>
    </owl:ObjectProperty>

    <!-- TIC / Process Events -->

    <owl:ObjectProperty rdf:about="#generatedEvent">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#TICEvent"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#measuredParameter">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="#Parameter"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#observedBySystem">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="#System"/>
    </owl:ObjectProperty>

    <!-- Part / Inspection -->

    <owl:ObjectProperty rdf:about="#hasPart">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="#Part"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#partOfBuild">
        <owl:inverseOf rdf:resource="#hasPart"/>
        <rdfs:domain rdf:resource="#Part"/>
        <rdfs:range rdf:resource="#Build"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasInspection">
        <rdfs:domain rdf:resource="#Part"/>
        <rdfs:range rdf:resource="#TICInspection"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#hasTestResult">
        <rdfs:domain rdf:resource="#TICInspection"/>
        <rdfs:range rdf:resource="#TestResult"/>
    </owl:ObjectProperty>

    <!-- ========================================= -->
    <!-- DATA PROPERTIES -->
    <!-- ========================================= -->

    <!-- TICEvent -->

    <owl:DatatypeProperty rdf:about="#valueNumeric">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#valueText">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#timestamp">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#xCoord">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#yCoord">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#zCoord">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#layerNumber">
        <rdfs:domain rdf:resource="#TICEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- Parameter -->

    <owl:DatatypeProperty rdf:about="#parameterName">
        <rdfs:domain rdf:resource="#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#parameterType">
        <rdfs:domain rdf:resource="#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#unit">
        <rdfs:domain rdf:resource="#Parameter"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- Material -->

    <owl:DatatypeProperty rdf:about="#materialName">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#alloy">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#supplier">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#reuseCount">
        <rdfs:domain rdf:resource="#Material"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- Machine -->

    <owl:DatatypeProperty rdf:about="#machineName">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#machineModel">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#laserType">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#nozzleType">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#buildVolumeXmm">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#buildVolumeYmm">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#buildVolumeZmm">
        <rdfs:domain rdf:resource="#AMMachine"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#float"/>
    </owl:DatatypeProperty>

    <!-- Build -->

    <owl:DatatypeProperty rdf:about="#buildStatus">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#buildType">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#layerCount">
        <rdfs:domain rdf:resource="#Build"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <!-- Geometry -->

    <owl:DatatypeProperty rdf:about="#regionType">
        <rdfs:domain rdf:resource="#GeometryRegion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#criticalityLevel">
        <rdfs:domain rdf:resource="#GeometryRegion"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <!-- ========================================= -->
    <!-- CLASS CONSTRAINTS -->
    <!-- ========================================= -->

    <owl:Class rdf:about="#Build">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#usesMachine"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

</rdf:RDF>